# Telegram bot token from @BotFather (required)
BOT_TOKEN=
# Comma-separated Telegram user IDs with admin rights
ADMIN_IDS=5985343016
# Chat IDs (users or groups) that receive "предложить новость" submissions, comma-separated
MEDIA_CHAT_IDS=
# Faculty id on tt.chuvsu.ru (32 = ВИШ)
FACULTY_ID=32
# Group prefixes hidden from users (comma-separated). ОЗВИШ = part-time groups
HIDDEN_GROUP_PREFIXES=ОЗВИШ
# Portal account (tt.chuvsu.ru) — only needed for teacher schedules; guests cannot open them
PORTAL_LOGIN=
PORTAL_PASSWORD=
# Telegram channel ids (bot must be admin there). Posts with #конкурс #объявление #событие are relayed to topic subscribers
NEWS_CHANNEL_IDS=
# Daily AI news scan of sources added with /source_add (needs ANTHROPIC_API_KEY). VK sources need a service token
VK_SERVICE_TOKEN=
NEWS_SCAN_CRON=30 10 * * *
NEWS_LOOKBACK_HOURS=32
NEWS_MAX_PER_TOPIC=8
# SQLite database file
DB_PATH=./data/vish-bot.sqlite
# Polling cadence (cron, Europe/Moscow). Busy = study hours, idle = the rest
POLL_CRON_BUSY=*/6 7-21 * * 1-6
POLL_CRON_IDLE=*/30 * * * *
# Optional: Anthropic key enables /ask (natural-language questions about the schedule)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
AI_DAILY_LIMIT_PER_USER=10
AI_DAILY_LIMIT_GLOBAL=300
# Dev only: skip TLS verification for the portal (never in production)
PORTAL_TLS_INSECURE=0
LOG_LEVEL=info
# Poster theme: midnight | editorial | brutalist | timeline
POSTER_THEME=midnight
# Calendar subscription (webcal). HTTP_PORT: port to listen on (Pterodactyl sets SERVER_PORT automatically, 0 = off).
# PUBLIC_URL: how phones reach that port from the internet, e.g. http://srv3.frienworld.space:40070
HTTP_PORT=0
PUBLIC_URL=
# Глобальный поиск студентов («сыск»). FALSE — раздела нет вообще: ни кнопок, ни команд
POISK=FALSE
# Файл со студентами (ФИО + группа): CSV, JSON или SQLite. Лежит ТОЛЬКО на сервере, в git не коммитится
POISK_DB=./data/students.csv
# Сколько раз в сутки один человек может искать людей (0 — без лимита, админы без лимита всегда)
POISK_DAILY_LIMIT=30
# «Бот узнаёт своих»: файл «ФИО;телеграм-ник», по нему бот здоровается по имени на /start.
# Ники в поиск студентов НЕ попадают — их читает отдельный модуль. Файл только на сервере, в git не коммитится.
# Собирается так: node scripts/known-from-xlsx.mjs data/known.csv data/students.csv реестр-телеграм.xlsx
# Нет файла — бот просто никого не узнаёт. Человек может выключить узнавание сам: ⚙️ Настройки → Усиленная анонимность.
KNOWN_DB=./data/known.csv
# Приём слайдов от сервера записи вебинаров (recorder/). Пусто — приём выключен
SLIDES_TOKEN=
SLIDES_DIR=./data/slides
