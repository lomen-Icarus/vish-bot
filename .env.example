# Telegram bot token from @BotFather (required)
BOT_TOKEN=
# Comma-separated Telegram user IDs with admin rights
ADMIN_IDS=5985343016
# Chat IDs (users or groups) that receive "предложить новость" submissions, comma-separated
MEDIA_CHAT_IDS=
# Faculty id on tt.chuvsu.ru (32 = ВИШ)
FACULTY_ID=32
# SQLite database file
DB_PATH=./data/vish-bot.sqlite
# Polling cadence (cron, Europe/Moscow). Busy = study hours, idle = the rest
POLL_CRON_BUSY=*/5 7-21 * * 1-6
POLL_CRON_IDLE=*/30 * * * *
# Optional: Anthropic key enables /ask (natural-language questions about the schedule)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_DAILY_LIMIT_PER_USER=10
AI_DAILY_LIMIT_GLOBAL=300
# Dev only: skip TLS verification for the portal (never in production)
PORTAL_TLS_INSECURE=0
LOG_LEVEL=info
