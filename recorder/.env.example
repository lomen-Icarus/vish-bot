# Учётка, которой бот заходит в комнату вебинара.
# 0 — слушатель (имя + пароль вебинара), 1 — обучающийся (Портфолио),
# 2 — сотрудник (Служебный портал), 4 — преподаватель (БРС)
WEBINAR_AUTH=1
WEBINAR_LOGIN=
WEBINAR_PASSWORD=
WEBINAR_DISPLAY_NAME=Бот ВИШ (слайды)

# Второй профиль (и третий… до _9): вебинар некоторых групп пускает только
# студента этих групп. Для пар перечисленных групп сначала пробуется этот
# профиль, потом первый; на пары других групп второй профиль не заходит.
# WEBINAR_AUTH_2 можно не задавать — по умолчанию 1 (обучающийся).
WEBINAR_LOGIN_2=
WEBINAR_PASSWORD_2=
WEBINAR_GROUPS_2=11-25,12-25,13-25,14-25,15-25

# Третий профиль — студент 4 курса, для потока 4 курса (набор 2023; групп 15-23 нет).
# «11-23» подходит и к «ВИШ-11-23(РЗиАЭС)», и к «ВИШ-11-23 (ЭиЭА)».
# WEBINAR_AUTH_3 можно не задавать — по умолчанию 1 (обучающийся).
WEBINAR_LOGIN_3=
WEBINAR_PASSWORD_3=
WEBINAR_GROUPS_3=11-23,12-23,13-23,14-23

FACULTY_ID=32
# Пусто = записывать все онлайн-пары ВИШ. Можно сузить, через запятую
RECORD_SUBJECTS=
RECORD_GROUPS=
# Не записывать пары, в названии которых есть это (через запятую, регистр не важен).
# Такие пары не занимают место из MAX_PARALLEL. Осторожно с короткими словами:
# «физическ» задело бы и «Физические основы электротехники».
# Например: SKIP_SUBJECTS=физической культур,физическая культура
SKIP_SUBJECTS=

LEAD_MINUTES=7
POLL_SECONDS=30
CAPTURE_SECONDS=5
# На сколько пикселей брать кадр шире области презентации вверх и вниз (верх слайда у BBB бывает под кромкой)
CAPTURE_PAD=40
MAX_MINUTES=110
# Сколько пар записывать одновременно: каждая — свой Chromium (память!).
# Одновременно у ВИШ бывает до 7 онлайн-пар; первыми берутся пары групп со
# своим профилем (WEBINAR_GROUPS_N). Больше 1 — только если памяти хватает
# на столько браузеров (~0,5–1 ГБ каждый, см. free -h и README)
MAX_PARALLEL=1

# Куда отдавать готовый PDF (адрес бота) и общий с ботом токен
BOT_SLIDES_URL=https://slides.secretvish.ru/slides
# Запасной HTTPS-адрес бота: если основной домен лёг (DNS), слайды и заявки идут
# сюда. Токен тот же и так же защищён HTTPS. Пусто — запаса нет.
BOT_SLIDES_FALLBACK_URL=
SLIDES_TOKEN=

OUT_DIR=./data/slides
HEADLESS=1
CHROMIUM_PATH=
LOG_LEVEL=info
