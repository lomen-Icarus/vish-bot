{
  "name": "vish-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram-бот расписания Высшей инженерной школы ЧувГУ",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "poll:once": "tsx src/cli.ts poll",
    "render:demo": "tsx src/cli.ts render-demo"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@fontsource/inter": "^5.3.0",
    "@grammyjs/auto-retry": "^2.0.2",
    "@grammyjs/runner": "^2.0.3",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^13.0.3",
    "chuvsu-js": "^5.2.1",
    "croner": "^10.0.1",
    "grammy": "^1.46.0",
    "pino": "^10.3.1",
    "satori": "^0.33.4",
    "undici": "^8.10.2",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
